[sub_resource type="GDScript" id="GDScript_hxaye"]
script/source = "extends Control

@export var debug_touch = false

func _ready() -> void:
	for child in $\".\".get_children():
		print(child.name)
	if !OS.has_feature(\"mobile\") && !debug_touch:
		$\".\".queue_free()
		pass

func _on_button_down() -> void:
	var ev = InputEventAction.new()
	ev.action = \"ui_accept\"
	ev.pressed = true
	Input.parse_input_event(ev)


func _on_button_up() -> void:
	var ev = InputEventAction.new()
	ev.action = \"ui_accept\"
	ev.pressed = false
	Input.parse_input_event(ev)
"

