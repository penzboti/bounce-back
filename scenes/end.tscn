[sub_resource type="GDScript" id="GDScript_s4tl2"]
script/source = "extends Button

@export var mobile_ui_scn: PackedScene

func _ready() -> void:
	if !OS.has_feature(\"mobileOS\"):
		$\".\".queue_free()


func _on_button_down() -> void:
	var node = mobile_ui_scn.instantiate()
	print(node.debug_touch)
	node.debug_touch = true
	print(\"halo\")
	$\"..\".add_child(node)
"

